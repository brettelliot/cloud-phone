# Always required: used for text-to-speech, and for speech-to-text if STT_PROVIDER=openai
OPENAI_API_KEY=

# Comma-separated fallback chain, tried in order for each reply; falls through
# to the next provider on any failure (overloaded, out of quota, network error,
# missing key, etc.) within the same turn.
LLM_PROVIDERS=gemini,openai,claude

# Required only when "claude" is in LLM_PROVIDERS
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# Required only when "gemini" is in LLM_PROVIDERS. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Only used when "openai" is in LLM_PROVIDERS, for replies
# OPENAI_CHAT_MODEL=gpt-4o-mini

# "wispr" (Wispr Flow REST API) or "openai" (Whisper, via OPENAI_API_KEY above)
STT_PROVIDER=wispr

# Required only when STT_PROVIDER=wispr. Get one at https://platform.wisprflow.ai/
WISPR_FLOW_API_KEY=
# WISPR_FLOW_LANGUAGE=en

# "keyboard" works on any machine (press Enter to pick up / hang up) and is the
# default while the phone's hook switch isn't wired up yet.
# "gpio" reads a real hook switch on the Raspberry Pi via gpiozero.
PHONE_TRIGGER=keyboard

# Only used when PHONE_TRIGGER=gpio
HOOK_GPIO_PIN=17

# Optional: override audio devices (see `python -m sounddevice` to list them)
# INPUT_DEVICE=
# OUTPUT_DEVICE=

# Optional: software gain applied to playback (greeting + TTS replies).
# 1.0 = unchanged, 2.0 = double amplitude, etc. Clipped to avoid distortion.
OUTPUT_VOLUME=1.5

# Optional: quiet R2D2-style beeps/chirps played while waiting for STT/LLM/TTS,
# instead of dead air. Set to false to disable and restore silent waits.
COMFORT_NOISE_ENABLED=true
COMFORT_NOISE_VOLUME=0.11

# Optional: checks every LLM reply against OpenAI's moderation API before it's
# spoken, swapping in CHILD_SAFETY_FALLBACK_REPLY if flagged (or if the check
# itself fails). Set to false to disable.
CHILD_SAFETY_ENABLED=true
# CHILD_SAFETY_FALLBACK_REPLY=Let's talk about something else -- what else are you curious about?
